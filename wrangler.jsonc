{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newt239",
  "compatibility_date": "2026-09-01",
  "preview_urls": true,
  "workers_dev": true,
  "routes": [
    {
      "pattern": "newt239.dev/*",
      "zone_name": "newt239.dev"
    }
  ],
  "assets": {
    "directory": "./.output/public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
