{
  "ci": {
    "collect": {
      "staticDistDir": ".output/public",
      "url": [
        "http://localhost/index.html",
        "http://localhost/works/index.html",
        "http://localhost/works/score-watcher/index.html",
        "http://localhost/works/quiz-flasher/index.html",
        "http://localhost/articles/index.html",
        "http://localhost/about/index.html"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.5 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "document-title": ["error", { "minScore": 1 }],
        "html-has-lang": ["error", { "minScore": 1 }],
        "is-crawlable": ["error", { "minScore": 1 }],
        "canonical": ["error", { "minScore": 1 }],
        "meta-description": "off",
        "robots-txt": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
