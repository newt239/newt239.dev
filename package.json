{
  "name": "newt239.dev",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "nuxt build",
    "compress": "node scripts/compress-images.ts",
    "content": "node scripts/generate-og-images.ts && node scripts/generate-llms-txt.ts && node scripts/generate-link-cards.ts",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "icons": "node scripts/generate-app-icons.ts",
    "lint": "eslint .",
    "lint:css": "stylelint \"**/*.{css,vue}\"",
    "lint:css:fix": "stylelint \"**/*.{css,vue}\" --fix",
    "lint:fix": "eslint . --fix",
    "lint:text": "textlint \"content/**/*.md\" \"README.md\"",
    "lint:text:fix": "textlint --fix \"content/**/*.md\" \"README.md\"",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "serve:static": "serve .output/public --listen 3100 --no-port-switching",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/content": "3.16.2",
    "@nuxt/image": "2.2.0",
    "@nuxtjs/sitemap": "9.1.0",
    "@tabler/icons-vue": "3.49.0",
    "nuxt": "4.6.2",
    "vue": "3.5.44",
    "vue-gtag-next": "1.14.0",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/eslint": "1.17.0",
    "@types/culori": "4.0.1",
    "@types/node": "26.6.5",
    "culori": "4.0.2",
    "eslint": "10.13.0",
    "postcss-html": "2.0.0",
    "satori": "0.63.2",
    "serve": "14.2.6",
    "sharp": "0.35.5",
    "stylelint": "17.16.0",
    "stylelint-config-recess-order": "7.9.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-order": "8.1.2",
    "stylelint-plugin-use-baseline": "1.4.8",
    "textlint": "15.8.0",
    "textlint-rule-preset-ai-writing": "1.1.0",
    "textlint-rule-preset-japanese": "10.0.4",
    "textlint-rule-preset-jtf-style": "3.0.3",
    "typescript": "6.0.3",
    "wrangler": "4.152.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
