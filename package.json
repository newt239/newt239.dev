{
  "name": "newt239.dev",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "bun --bun nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "bun --bun nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:text": "textlint \"content/**/*.md\" \"README.md\"",
    "lint:text:fix": "textlint --fix \"content/**/*.md\" \"README.md\"",
    "compress": "bun run scripts/compress-images.ts",
    "og": "bun run scripts/generate-og-images.ts",
    "serve:static": "serve .output/public --listen 3100 --no-port-switching",
    "a11y": "axe http://localhost:3100/ http://localhost:3100/works http://localhost:3100/works/score-watcher http://localhost:3100/works/icondle http://localhost:3100/articles http://localhost:3100/about http://localhost:3100/privacy --tags wcag2a,wcag2aa,wcag21a,wcag21aa,wcag22a,wcag22aa --exit"
  },
  "dependencies": {
    "@nuxt/content": "3.15.2",
    "@nuxt/eslint": "1.16.0",
    "@nuxt/image": "2.1.0",
    "@tabler/icons-vue": "3.46.0",
    "dayjs": "1.11.21",
    "eslint": "10.8.0",
    "nuxt": "4.5.1",
    "vue": "3.5.40",
    "vue-gtag-next": "1.14.0",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@axe-core/cli": "4.12.1",
    "@nuxtjs/sitemap": "8.3.2",
    "@types/node": "26.1.2",
    "satori": "0.29.0",
    "serve": "14.2.6",
    "sharp": "0.35.3",
    "textlint": "15.8.0",
    "textlint-rule-preset-ai-writing": "1.1.0",
    "textlint-rule-preset-japanese": "10.0.4",
    "textlint-rule-preset-jtf-style": "3.0.3",
    "typescript": "6.0.3",
    "yaml": "2.9.0"
  }
}
